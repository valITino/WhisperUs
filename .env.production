# Public values only. The publishable key is safe to ship: the database's
# row-level security decides what any phone may read or write, and what is
# inside an envelope is sealed on the phone before it ever gets there.
#
# Empty until the room's own Supabase project exists (README: "Connecting the
# cloud"). A build without them shows one page that says so. Never put another
# project's address here: this app must not talk to anybody else's data.
VITE_BACKEND=supabase
VITE_SUPABASE_URL=
VITE_SUPABASE_KEY=
